# Application Settings
APP_NAME="LedgerOne"
APP_VERSION="0.1.0"
DEBUG=false

# Security
# Random 32-byte hex for signing
SECRET_KEY="supersecretkey_please_change_in_production"
# JWT signing secret
JWT_SECRET="jwtsecretkey_please_change_in_production"
# Token expiry (24 hours)
JWT_EXPIRE_MINUTES=1440

# CORS
# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000"

# Database
# PostgreSQL asyncpg connection string
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ca_tool"
DATABASE_POOL_SIZE=10

# Redis/Worker
# Redis connection string
REDIS_URL="redis://localhost:6379/0"
# Concurrent Celery workers (1 for GPU)
CELERY_WORKERS=1
# Redis TTL for reconciliation cache
RECONCILIATION_CACHE_TTL=3600

# Ollama / GenAI
# Ollama API base URL
OLLAMA_BASE_URL="http://localhost:11434"
# Model name for extraction and Q&A
OLLAMA_MODEL="gemma4:e4b"
# Model for embeddings
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
# Seconds before Ollama call times out
OLLAMA_TIMEOUT=120
# Retry attempts for failed Ollama calls
OLLAMA_MAX_RETRIES=3

# Processing Configuration
# Root path for uploaded files
STORAGE_PATH="./storage"
# Maximum upload file size
MAX_FILE_SIZE_MB=50
# Maximum PDF pages to process
MAX_PAGES_PER_DOC=100
# Audio chunk size for Gemma4
AUDIO_CHUNK_SECONDS=30
# DPI for scanned PDF conversion
PDF_DPI=150
# Vector dimension (must match model)
EMBEDDING_DIM=768
# Oauth2 
VITE_GOOGLE_CLIENT_ID="8519298792-3a2951vqnmg968106c5rmnm4l2v01k96.apps.googleusercontent.com"
# SMTP password
SMTP_PASSWORD="uxlolpganhkagxvh"
SMTP_USER="workstudiotwelve@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
ADMIN_EMAIL="workstudiotwelve@gmail.com"